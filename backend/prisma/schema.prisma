generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Module {
  id                 String          @id @default(cuid())
  number             Int             @unique
  title              String
  subtitle           String
  level              String
  estimatedTime      String
  description        String
  learningObjectives String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  activities         Activity[]
  certifications     Certification[]
  certificates       Certificate[]
  lessons            Lesson[]
  quizzes            Quiz[]

  @@index([number])
}

model Lesson {
  id         String           @id @default(cuid())
  moduleId   String
  order      Int
  title      String
  content    Json
  keyInsight String?
  video      Json?
  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId, order])
}

model Quiz {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  questions   Json
  type        String
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions QuizSubmission[]

  @@index([moduleId, type])
}

model Learner {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  avatar              String?
  enrolledAt          DateTime             @default(now())
  currentStreak       Int                  @default(0)
  lastActivityAt      DateTime             @default(now())
  certificates        Certificate[]
  progress            LessonProgress[]
  quizSubmissions     QuizSubmission[]
  payments            Payment[]
  activityCompletions ActivityCompletion[]

  @@index([email])
}

model LessonProgress {
  id          String    @id @default(cuid())
  learnerId   String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  timeSpent   Int?
  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([learnerId])
  @@index([lessonId])
}

model QuizSubmission {
  id              String         @id @default(cuid())
  learnerId       String
  quizId          String?
  certificationId String?
  answers         Json
  score           Int
  maxScore        Int
  passed          Boolean
  submittedAt     DateTime       @default(now())
  learner         Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  quiz            Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([learnerId, quizId])
  @@index([learnerId, certificationId])
  @@index([submittedAt])
}

// Earned on passing the certification assessment, issued on first view after
// payment: issuing fixes the recipient's name and signs the record
model Certificate {
  id              String                  @id @default(cuid())
  learnerId       String
  moduleId        String
  certificateId   String                  @unique
  earnedAt        DateTime                @default(now())
  recipientName   String?
  // Raised by every name correction; copies printed before it are superseded
  revision        Int                     @default(1)
  // Ed25519 over the issued fields (see core/utils/certificate-signing.ts)
  signature       String?
  // No longer written or read; kept until this release is live so rolling back
  // stays safe, then dropped in a migration of its own
  verificationUrl String?
  learner         Learner                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  module          Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  payments        Payment[]
  nameChanges     CertificateNameChange[]

  @@unique([learnerId, moduleId])
  @@index([certificateId])
  @@index([learnerId])
}

// Audit trail of name corrections on issued certificates; never edited or deleted
model CertificateNameChange {
  id            String      @id @default(cuid())
  certificateId String
  previousName  String
  newName       String
  reason        String
  // The certificate revision this correction produced
  revision      Int
  ipAddress     String?
  createdAt     DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
}

// One row per payment attempt; a certificate is paid once any attempt succeeds
model Payment {
  id            String        @id @default(cuid())
  learnerId     String
  certificateId String
  provider      String
  reference     String        @unique
  accessCode    String?
  amountMinor   Int
  currency      String
  fxRate        Decimal?      @db.Decimal(18, 6)
  status        PaymentStatus @default(PENDING)
  channel       String?
  providerTxnId String?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  learner       Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  certificate   Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId, status])
  @@index([learnerId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Activity {
  id          String               @id @default(cuid())
  moduleId    String
  title       String
  description String
  content     Json
  module      Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions ActivityCompletion[]
}

model ActivityCompletion {
  id          String   @id @default(cuid())
  learnerId   String
  activityId  String
  completedAt DateTime @default(now())
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([learnerId, activityId])
  @@index([learnerId])
}

model Certification {
  id            String           @id @default(cuid())
  moduleId      String
  title         String
  requiredScore Int
  content       Json
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions   QuizSubmission[]
}
