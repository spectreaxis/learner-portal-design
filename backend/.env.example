# Provider Configuration (switch between implementations)
AUTH_PROVIDER=jwt           # Options: jwt | supabase
DATA_PROVIDER=prisma        # Options: prisma | supabase

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/learner_portal"

# JWT Configuration (for jwt auth provider)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Supabase Configuration (for supabase providers - optional)
# SUPABASE_URL="https://xxx.supabase.co"
# SUPABASE_SERVICE_KEY="your-service-role-key"
# SUPABASE_ANON_KEY="your-anon-key"

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
